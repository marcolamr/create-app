    )
  }
  {
    icon === 'typescript' && (
      <svg aria-hidden="true" version="1.1" viewBox="0 0 512 512" fill="currentColor" xmlns="http://www.w3.org/2000/svg"> <title>TypeScript</title> <rect width="512" height="512" rx="50" fill="#3178c6"></rect> <path d="m317 407v50c8.1 4.2 18 7.3 29 9.4s23 3.1 35 3.1c12 0 23-1.1 34-3.4 11-2.3 20-6.1 28-11 8.1-5.3 15-12 19-21s7.1-19 7.1-32c0-9.1-1.4-17-4.1-24s-6.6-13-12-18c-5.1-5.3-11-10-18-14s-15-8.2-24-12c-6.6-2.7-12-5.3-18-7.9-5.2-2.6-9.7-5.2-13-7.8-3.7-2.7-6.5-5.5-8.5-8.4-2-3-3-6.3-3-10 0-3.4 0.89-6.5 2.7-9.3s4.3-5.1 7.5-7.1c3.2-2 7.2-3.5 12-4.6 4.7-1.1 9.9-1.6 16-1.6 4.2 0 8.6 0.31 13 0.94 4.6 0.63 9.3 1.6 14 2.9 4.7 1.3 9.3 2.9 14 4.9 4.4 2 8.5 4.3 12 6.9v-47c-7.6-2.9-16-5.1-25-6.5s-19-2.1-31-2.1c-12 0-23 1.3-34 3.8s-20 6.5-28 12c-8.1 5.4-14 12-19 21-4.7 8.4-7 18-7 30 0 15 4.3 28 13 38 8.6 11 22 19 39 27 6.9 2.8 13 5.6 19 8.3s11 5.5 15 8.4c4.3 2.9 7.7 6.1 10 9.5 2.5 3.4 3.8 7.4 3.8 12 0 3.2-0.78 6.2-2.3 9s-3.9 5.2-7.1 7.2-7.1 3.6-12 4.8c-4.7 1.1-10 1.7-17 1.7-11 0-22-1.9-32-5.7-11-3.8-21-9.5-30-17zm-84-123h64v-41h-179v41h64v183h51z" clip-rule="evenodd" fill="#fff" fill-rule="evenodd" style="fill:#fff"></path> </svg>
    )
  }
  {
    icon === 'drizzle' && (
      <svg viewBox="14 17 52 36" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <rect
          width="5.25365"
          height="22.2834"
          rx="2.62683"
          transform="matrix(0.873028 0.48767 -0.497212 0.867629 16.0791 30.3292)"
          fill="currentColor"
        />
        <rect
          width="5.25365"
          height="22.2834"
          rx="2.62683"
          transform="matrix(0.873028 0.48767 -0.497212 0.867629 34.3301 19)"
          fill="currentColor"
        />
        <rect
          width="5.25365"
          height="22.2834"
          rx="2.62683"
          transform="matrix(0.873028 0.48767 -0.497212 0.867629 62.4131 19.0005)"
          fill="currentColor"
        />
        <rect
          width="5.25365"
          height="22.2834"
          rx="2.62683"
          transform="matrix(0.873028 0.48767 -0.497212 0.867629 44.1562 30.3292)"
          fill="currentColor"
        />
      </svg>
    )
  }
  {
    icon === 'better-auth' && (
      <svg xmlns="http://www.w3.org/2000/svg" width="400" height="300" viewBox="0 0 400 300" fill="currentColor">
          <path fill-rule="evenodd" d="M0 150v150h100V200h100v100h200V0H200v100H100V0H0zm300 0v50H200V100h100z" />
