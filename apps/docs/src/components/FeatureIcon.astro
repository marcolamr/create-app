  {
    icon === 'tailwind' && (
      <svg viewBox="0 0 24 24" fill="currentColor">
        <path d="M12.001 4.8c-3.2 0-5.2 1.6-6 4.8 1.2-1.6 2.6-2.2 4.2-1.8.913.228 1.565.89 2.288 1.624C13.666 10.618 15.027 12 18.001 12c3.2 0 5.2-1.6 6-4.8-1.2 1.6-2.6 2.2-4.2 1.8-.913-.228-1.565-.89-2.288-1.624C16.337 6.182 14.976 4.8 12.001 4.8zm-6 7.2c-3.2 0-5.2 1.6-6 4.8 1.2-1.6 2.6-2.2 4.2-1.8.913.228 1.565.89 2.288 1.624 1.177 1.194 2.538 2.576 5.512 2.576 3.2 0 5.2-1.6 6-4.8-1.2 1.6-2.6 2.2-4.2 1.8-.913-.228-1.565-.89-2.288-1.624C10.337 13.382 8.976 12 6.001 12z" />
      </svg>
    )
  }
  {
    icon === 't3-env' && (
      <svg width="258" height="198" viewBox="0 0 258 198" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
        <path d="M165.269 24.0976L188.481 -0.000411987H0V24.0976H165.269Z" fill="currentColor"></path>
        <path d="M163.515 95.3516L253.556 2.71059H220.74L145.151 79.7886L163.515 95.3516Z" fill="currentColor"></path>
        <path d="M233.192 130.446C233.192 154.103 214.014 173.282 190.357 173.282C171.249 173.282 155.047 160.766 149.534 143.467L146.159 132.876L126.863 152.171L128.626 156.364C138.749 180.449 162.568 197.382 190.357 197.382C227.325 197.382 257.293 167.414 257.293 130.446C257.293 105.965 243.933 84.7676 224.49 73.1186L219.929 70.3856L202.261 88.2806L210.322 92.5356C223.937 99.7236 233.192 114.009 233.192 130.446Z" fill="currentColor"></path>
        <path d="M87.797 191.697V44.6736H63.699V191.697H87.797Z" fill="currentColor"></path>
      </svg>
    )
  }
</span>

<style>
  .feature-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 0.5rem;
    flex-shrink: 0;
  }

  .feature-icon svg {
    width: 1.25rem;
    height: 1.25rem;
  }

  .feature-icon--nextjs {
    background: rgba(255, 255, 255, 0.08);
    color: #fafafa;
  }

  .feature-icon--typescript {
    background: rgba(49, 120, 198, 0.18);
    color: #60a5fa;
  }

  .feature-icon--drizzle {
    background: rgba(190, 242, 100, 0.12);
    color: #bef264;
  }

  .feature-icon--better-auth {
    background: rgba(167, 139, 250, 0.15);
    color: #c4b5fd;
  }

  .feature-icon--tailwind {
    background: rgba(6, 182, 212, 0.15);
    color: #22d3ee;
  }

  .feature-icon--t3-env {
    background: rgba(124, 58, 237, 0.18);
    color: #a78bfa;
  }
</style>
