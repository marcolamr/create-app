{
  "name": "@madda/root",
  "description": "Monorepo for @madda/create-app — scaffold web apps with the madda stack",
  "author": "Marcos Roberto <marcola.mr@gmail.com> (https://github.com/marcolamr)",
  "maintainers": [
    "Marcos Roberto <marcola.mr@gmail.com> (https://github.com/marcolamr)"
  ],
  "private": true,
  "prettier": "@repo/prettier-config",
  "keywords": [
    "@madda/create-app",
    "madda",
    "madda-stack",
    "next.js",
    "tailwind",
    "typescript"
  ],
  "scripts": {
    "build": "turbo run build",
    "build:cli": "turbo --filter=@madda/create-app build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "format:check": "turbo run format:check",
    "check-types": "turbo run check-types",
    "changeset": "changeset",
    "release": "changeset version",
    "pub:beta": "pnpm --filter @madda/create-app pub:beta",
    "pub:release": "pnpm --filter @madda/create-app pub:release"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.8",
    "@repo/prettier-config": "workspace:*",
    "prettier": "^3.7.4",
    "turbo": "^2.9.14",
    "typescript": "5.9.2"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18"
  }
}
