{
  "name": "@madda/root",
  "description": "Monorepo for @madda/app — scaffold web apps with the madda stack",
  "author": "Marcos Roberto <marcola.mr@gmail.com> (https://github.com/marcolamr)",
  "maintainers": [
    "Marcos Roberto <marcola.mr@gmail.com> (https://github.com/marcolamr)"
  ],
  "private": true,
  "prettier": "@repo/prettier-config",
  "keywords": [
    "@madda/app",
    "madda",
    "madda-stack",
    "next.js",
    "tailwind",
    "typescript"
  ],
  "scripts": {
    "build": "turbo run build",
    "build:cli": "turbo --filter=@madda/app build",
    "build:docs": "turbo --filter=@madda/docs build",
    "dev:docs": "turbo --filter=@madda/docs dev",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "format:check": "turbo run format:check",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "test:coverage": "pnpm --filter @madda/app test:coverage && node scripts/update-readme-coverage.mjs",
    "changeset": "changeset",
    "release": "changeset version",
    "pub:beta": "pnpm --filter @madda/app pub:beta",
    "pub:release": "pnpm --filter @madda/app pub:release",
    "deps:check": "ncu --deep",
    "deps:update": "ncu --deep -u",
    "deps:interactive": "ncu --deep -i"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@repo/prettier-config": "workspace:*",
    "npm-check-updates": "^22.2.1",
    "prettier": "^3.8.3",
    "turbo": "^2.9.16",
    "typescript": "6.0.3"
  },
  "packageManager": "pnpm@11.4.0",
  "engines": {
    "node": ">=18"
  }
}
