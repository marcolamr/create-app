---
import type { Lang } from '../i18n';
import { copy } from '../i18n';
import PageShell from './PageShell.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = copy[lang];
const prefix = lang === 'pt-br' ? '/pt-br' : '';
---

<PageShell lang={lang} title="madda">
  <main>
    <section class="hero">
      <p class="badge">@madda/app · CLI</p>
      <h1>
        {t.heroTitle}
        <span class="gradient">{t.heroHighlight}</span>
        {t.heroSuffix}
      </h1>
      <p class="lead">{t.heroSub}</p>
      <div class="actions">
        <a class="btn primary" href={`${prefix}/docs/`}>{t.ctaPrimary}</a>
        <a class="btn secondary" href={`${prefix}/docs/installation/`}>{t.ctaSecondary}</a>
      </div>
      <div class="terminal" aria-label="install command">
        <code>{t.install}</code>
        <button type="button" data-copy={t.install} class="copy">Copy</button>
      </div>
    </section>

    <section class="section">
      <h2>{t.stackTitle}</h2>
      <p class="muted">{t.stackSub}</p>
      <div class="grid">
        {
          t.features.map((f) => (
            <article class="card">
              <h3>{f.name}</h3>
              <p>{f.desc}</p>
            </article>
          ))
        }
      </div>
    </section>

    <section class="section split">
      <div>
        <h2>{t.modularTitle}</h2>
        <p class="muted">{t.modularBody}</p>
      </div>
      <div class="link-cards">
        <a class="card link" href={`${prefix}/docs/`}>
          <h3>{t.docsCard}</h3>
          <p>{t.docsDesc}</p>
        </a>
        <a class="card link" href={`${prefix}/faq`}>
          <h3>{t.faqCard}</h3>
          <p>{t.faqDesc}</p>
        </a>
      </div>
    </section>
  </main>
</PageShell>

<script>
  document.querySelectorAll('[data-copy]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const text = btn.getAttribute('data-copy');
      if (!text) return;
      await navigator.clipboard.writeText(text);
      btn.textContent = 'Copied!';
      setTimeout(() => {
        btn.textContent = 'Copy';
      }, 1500);
    });
  });
</script>

<style>
  main {
    flex: 1;
    max-width: 72rem;
    margin: 0 auto;
    padding: 0 1.5rem 4rem;
    width: 100%;
    box-sizing: border-box;
  }

  .hero {
    padding: 4rem 0 3rem;
    text-align: center;
  }

  .badge {
    display: inline-block;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #a78bfa;
    border: 1px solid rgba(167, 139, 250, 0.35);
    border-radius: 999px;
    padding: 0.35rem 0.85rem;
    margin-bottom: 1.5rem;
  }

  h1 {
    font-size: clamp(2.25rem, 5vw, 3.5rem);
    line-height: 1.1;
    letter-spacing: -0.04em;
    max-width: 18ch;
    margin: 0 auto 1rem;
    font-weight: 700;
  }

  .gradient {
    background: linear-gradient(135deg, #c4b5fd, #7c3aed 55%, #4f46e5);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .lead {
    font-size: 1.15rem;
    color: #a1a1aa;
    max-width: 42rem;
    margin: 0 auto 2rem;
    line-height: 1.6;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    justify-content: center;
    margin-bottom: 2rem;
  }

  .btn {
    padding: 0.65rem 1.25rem;
    border-radius: 0.55rem;
    font-weight: 600;
    text-decoration: none;
    font-size: 0.95rem;
  }

  .btn.primary {
    background: linear-gradient(135deg, #7c3aed, #6d28d9);
    color: white;
    box-shadow: 0 0 40px rgba(124, 58, 237, 0.35);
  }

  .btn.secondary {
    border: 1px solid rgba(255, 255, 255, 0.2);
    color: #fafafa;
  }

  .terminal {
    display: inline-flex;
    align-items: center;
    gap: 1rem;
    background: #18181b;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 0.65rem;
    padding: 0.85rem 1rem;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.9rem;
  }

  .copy {
    background: transparent;
    border: 1px solid rgba(255, 255, 255, 0.15);
    color: #a1a1aa;
    border-radius: 0.35rem;
    padding: 0.25rem 0.5rem;
    cursor: pointer;
    font-size: 0.75rem;
  }

  .section {
    padding: 3rem 0;
  }

  .section h2 {
    font-size: 1.75rem;
    letter-spacing: -0.03em;
    margin: 0 0 0.5rem;
  }

  .muted {
    color: #a1a1aa;
    max-width: 50ch;
    line-height: 1.6;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr));
    gap: 1rem;
    margin-top: 2rem;
  }

  .card {
    background: #18181b;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 0.75rem;
    padding: 1.25rem;
  }

  .card h3 {
    margin: 0 0 0.5rem;
    font-size: 1.05rem;
  }

  .card p {
    margin: 0;
    color: #a1a1aa;
    font-size: 0.9rem;
    line-height: 1.5;
  }

  .split {
    display: grid;
    gap: 2rem;
  }

  @media (min-width: 768px) {
    .split {
      grid-template-columns: 1fr 1fr;
      align-items: start;
    }
  }

  .link-cards {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .card.link {
    text-decoration: none;
    color: inherit;
    transition: border-color 0.15s, transform 0.15s;
  }

  .card.link:hover {
    border-color: rgba(167, 139, 250, 0.5);
    transform: translateY(-2px);
  }
</style>
