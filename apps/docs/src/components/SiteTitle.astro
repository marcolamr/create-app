---
const { siteTitle, siteTitleHref } = Astro.locals.starlightRoute;
---

<a href={siteTitleHref} class="site-title">
  <strong>{siteTitle}<span class="accent">.</span></strong>
</a>

<style>
  .site-title {
    color: inherit;
    text-decoration: none;
    font-size: 1.8rem;
    letter-spacing: -0.03em;
  }
</style>
