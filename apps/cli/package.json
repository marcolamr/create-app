{
  "name": "@madda/app",
  "version": "1.0.3",
  "description": "Create web applications with the madda stack",
  "license": "MIT",
  "type": "module",
  "exports": "./dist/index.js",
  "bin": {
    "madda-app": "./dist/index.js"
  },
  "files": [
    "dist",
    "template",
    "CHANGELOG.md",
    "package.json"
  ],
  "publishConfig": {
    "access": "public"
  },
  "prettier": "@repo/prettier-config",
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "start": "node dist/index.js",
    "lint": "eslint --max-warnings 0",
    "lint:fix": "pnpm lint --fix && pnpm format",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "pub:beta": "pnpm build && npm publish --access public --tag beta",
    "pub:release": "pnpm build && npm publish --access public"
  },
  "dependencies": {
    "@clack/core": "^1.3.1",
    "@clack/prompts": "^1.4.0",
    "chalk": "^5.6.2",
    "commander": "^14.0.3",
    "execa": "^9.6.1",
    "figlet": "^1.11.0",
    "fs-extra": "^11.3.5",
    "gradient-string": "^3.0.0",
    "ora": "^9.4.0",
    "sort-package-json": "^3.6.1"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/prettier-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/figlet": "^1.7.0",
    "@types/fs-extra": "^11.0.4",
    "@types/gradient-string": "^1.1.6",
    "@types/node": "^25.9.1",
    "eslint": "^9.39.1",
    "prettier": "^3.7.4",
    "tsup": "^8.5.1",
    "type-fest": "^5.6.0",
    "typescript": "5.9.2",
    "vitest": "^3.2.4",
    "@vitest/coverage-v8": "^3.2.4"
  }
}
